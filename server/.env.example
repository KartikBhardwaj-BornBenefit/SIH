# Copy this file to server/.env and paste your OpenRouter API key (sk-or-...).
# The extension never reads this file. Only `npm run server` does.
# Values already in the environment win over this file.

AGENT_PROVIDER=openrouter
AGENT_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
AGENT_MODEL=qwen/qwen3.7-flash
AGENT_FALLBACK_MODELS=openai/gpt-4o-mini
AGENT_API_KEY=
AGENT_IMAGE_ENABLED=true
AGENT_MAX_TOKENS=4096

# Other OpenAI-compatible hosts still work. Examples:
# AGENT_PROVIDER=openai
# AGENT_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# AGENT_MODEL=gemini-3.8-flash
# AGENT_FALLBACK_MODELS=
# AGENT_ENDPOINT=https://api.openai.com/v1/chat/completions
# AGENT_MODEL=gpt-4o-mini
