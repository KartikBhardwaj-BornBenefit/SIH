{
  "manifest_version": 3,
  "name": "Privacy-Preserving Browser Agent",
  "version": "0.7.0",
  "description": "Redacts identifiers on-device, sends only placeholders plus your instruction to a server model, and applies the returned actions in the tab.",
  "action": {
    "default_title": "Analyze current page",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/serviceWorker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "offscreen", "unlimitedStorage", "storage"],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "toggle-agent-pause": {
      "description": "Pause or resume the agent so you can type (OTP, password, etc.)",
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
